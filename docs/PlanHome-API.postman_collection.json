      "name": "06. GET produtos (catálogo público) -> 200, guarda um produto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", function () { pm.response.to.have.status(200); });",
              "const lista = pm.response.json();",
              "pm.test(\"É uma lista\", function () { pm.expect(lista).to.be.an(\"array\"); });",
              "if (lista.length > 0) { pm.collectionVariables.set(\"produto_id\", lista[0].id); }"
